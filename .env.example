# ---- Backend (backend/.env) ----
# Managed PostgreSQL connection string (Neon, Supabase, RDS, local docker...)
DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# Random secret used to sign demo faculty session cookies.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Exact origin of the Next.js frontend, used for CORS + cookie policy.
FRONTEND_ORIGIN=http://localhost:3000

# Illustrative attendance threshold (percent). NOT an official college regulation.
ATTENDANCE_THRESHOLD=75

# Set to 1 in production so session cookies are Secure + SameSite=None.
COOKIE_SECURE=0

# ---- Frontend (frontend/.env.local) ----
# Public base URL of the FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
